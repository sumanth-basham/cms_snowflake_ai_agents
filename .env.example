# =============================================================================
# .env.example — Environment variable template for CMS Snowflake AI Agents
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is excluded from git (see .gitignore).
# NEVER commit real credentials to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Snowflake Connection
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=<your-account>.snowflakecomputing.com
SNOWFLAKE_USER=<your-service-account-username>
SNOWFLAKE_ROLE=CMS_STARS_ANALYST
SNOWFLAKE_WAREHOUSE=CMS_STARS_WH
SNOWFLAKE_DATABASE=CMS_STARS_DB
SNOWFLAKE_SCHEMA=SCHEMA_GOLD

# ---------------------------------------------------------------------------
# Snowflake Authentication — choose ONE method
# ---------------------------------------------------------------------------

# METHOD 1 (Recommended): Programmatic Access Token (PAT)
#   Generate: Snowflake UI → User Menu → My Profile → Security → PAT → + New Token
SNOWFLAKE_PAT=

# METHOD 2: Key-pair (JWT) authentication
SNOWFLAKE_AUTHENTICATOR=
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8

# METHOD 3: Password (least preferred for production)
SNOWFLAKE_PASSWORD=

# ---------------------------------------------------------------------------
# Cortex / LLM Settings
# ---------------------------------------------------------------------------
CORTEX_LLM_MODEL=mistral-large2
CORTEX_EMBED_MODEL=snowflake-arctic-embed-l-v2.0
MEASUREMENT_YEAR=2024

# ---------------------------------------------------------------------------
# Claude / Anthropic
# ---------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# FastAPI Settings
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
# Optional: Set an API key to protect the /ask endpoint
API_KEY=

# Query limits
MAX_RESULT_ROWS=1000
DEFAULT_PAGE_SIZE=100
QUERY_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Cache Settings
# ---------------------------------------------------------------------------
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=256

# ---------------------------------------------------------------------------
# CORS (comma-separated list of allowed origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend / Streamlit
# ---------------------------------------------------------------------------
FRONTEND_API_URL=http://localhost:8000
